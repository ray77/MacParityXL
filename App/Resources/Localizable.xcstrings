        }
      }
    },
    "The same password is used for the entire archive.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für das ganze Archiv wird dasselbe Passwort verwendet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le même mot de passe est utilisé pour toute l’archive."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se usa la misma contraseña para todo el archivo comprimido."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для всього архіву використовується той самий пароль."
          }
        }
      }
    },
    "Then": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dann"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alors"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entonces"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тоді"
          }
        }
      }
    },
    "They probably don't belong to this PAR set. Scanning them for missing data can take a long time.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie gehören wahrscheinlich nicht zu diesem PAR-Set. Sie nach fehlenden Daten zu durchsuchen, kann lange dauern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ils n’appartiennent probablement pas à ce jeu PAR. Y rechercher les données manquantes peut prendre longtemps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Probablemente no pertenecen a este conjunto PAR. Buscar en ellos los datos que faltan puede tardar mucho."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Імовірно, вони не належать до цього набору PAR. Пошук у них відсутніх даних може тривати довго."
          }
        }
      }
    },
    "This file is checked, but it did not contribute to the recovery files, so it can't be restored.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei wird geprüft, ist aber nicht in die Wiederherstellungsdateien eingeflossen und kann daher nicht wiederhergestellt werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier est vérifié, mais il n’a pas contribué aux fichiers de récupération et ne peut donc pas être restauré."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este archivo se comprueba, pero no contribuyó a los archivos de recuperación, así que no se puede restaurar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей файл перевіряється, але не увійшов до файлів відновлення, тому його не можна відновити."
          }
        }
      }
    },
    "Too many files; the set has room for %lld more.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu viele Dateien; das Set hat nur noch Platz für %lld."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop de fichiers ; le jeu n’a de place que pour %lld de plus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Demasiados archivos; el conjunto solo admite %lld más."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Забагато файлів; у наборі залишилося місць: %lld."
          }
        }
      }
    },
    "Total": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesamt"
          }
        },
        "fr": {
