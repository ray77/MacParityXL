    },
    "Unattended runs show no dialogs. Existing items are kept, passwords are skipped, and errors are reported as notifications.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unbeaufsichtigte Durchläufe zeigen keine Dialoge. Vorhandene Objekte bleiben erhalten, Passwörter werden übersprungen und Fehler als Mitteilungen gemeldet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les exécutions sans surveillance n’affichent aucune boîte de dialogue. Les éléments existants sont conservés, les mots de passe ignorés et les erreurs signalées par des notifications."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las ejecuciones desatendidas no muestran diálogos. Los elementos existentes se conservan, las contraseñas se omiten y los errores se notifican."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматичний режим не показує діалогів. Наявні елементи зберігаються, паролі пропускаються, а про помилки повідомляють сповіщення."
          }
        }
      }
    },
